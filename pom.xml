<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.devlens</groupId>
  <artifactId>devlens</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>DevLens MCP Server</name>
  <description>
    MCP server exposing provenance-tagged, statically extracted facts about source repositories.
    No LLM calls are made server-side by design.
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- MCP protocol -->
    <mcp.version>2.0.1</mcp.version>

    <!-- Static extraction: bonede tree-sitter bindings ship precompiled native
         libraries and target Java 11+. Deliberately NOT io.github.tree-sitter:jtreesitter,
         which needs JDK 23+ and no grammars are bundled. -->
    <tree-sitter.version>0.26.6</tree-sitter.version>
    <ts-java.version>0.23.5</ts-java.version>
    <ts-javascript.version>0.25.0</ts-javascript.version>
    <ts-typescript.version>0.23.2</ts-typescript.version>

    <jgit.version>7.7.1.202607240634-r</jgit.version>
    <slf4j.version>2.0.18</slf4j.version>
    <junit.version>5.14.1</junit.version>

    <compiler-plugin.version>3.14.1</compiler-plugin.version>
    <surefire-plugin.version>3.5.6</surefire-plugin.version>
    <failsafe-plugin.version>3.5.6</failsafe-plugin.version>
    <shade-plugin.version>3.6.2</shade-plugin.version>

    <main.class>com.devlens.DevLensServer</main.class>

    <!-- Overridable so the integration tests can be pointed at a different (or deliberately
         missing) metadata store, e.g. -Ddevlens.it.dataDir=/tmp/empty to confirm they are not
         passing vacuously. -->
    <devlens.it.dataDir>${project.basedir}/devlens-data</devlens.it.dataDir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- MCP server + STDIO/SSE/Streamable-HTTP transports, bundled with Jackson 3 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
    </dependency>

    <!-- Repo access without requiring a git binary on PATH -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>${jgit.version}</version>
    </dependency>

    <!-- tree-sitter core + grammars for the pilot languages -->
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter</artifactId>
      <version>${tree-sitter.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter-java</artifactId>
      <version>${ts-java.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter-javascript</artifactId>
      <version>${ts-javascript.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter-typescript</artifactId>
      <version>${ts-typescript.version}</version>
    </dependency>

    <!-- IMPORTANT: on a STDIO transport, stdout is the JSON-RPC channel.
         slf4j-simple is configured in simplelogger.properties to write to System.err.
         Anything logged to stdout corrupts the protocol stream. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>devlens</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
      </plugin>

      <!-- Integration tests (*IT) run after packaging, against the shaded jar as a real
           subprocess. They are the only place the actual client contract is exercised:
           native library loading and stdout purity cannot be verified from unit tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${failsafe-plugin.version}</version>
        <configuration>
          <environmentVariables>
            <DEVLENS_DATA_DIR>${devlens.it.dataDir}</DEVLENS_DATA_DIR>
          </environmentVariables>
          <systemPropertyVariables>
            <devlens.jar>${project.build.directory}/${project.build.finalName}.jar</devlens.jar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Fat jar: an MCP client launches this as `java -jar devlens.jar`,
           so every dependency (including tree-sitter natives) must be inside. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
